// Proyecto 6, parte de Zetariano: ciclos, ciclos anidados y saltos.
// Equivalente a la parte de Y y a la de PigLatin del mismo proyecto.
public class Ciclos {
    int total;

    public Ciclos() {
        total = 0;
    }

    // for con continue y break en el mismo ciclo.
    public int conSaltos(int hasta) {
        int i;
        int suma;
        suma = 0;
        for (i = 0; i < hasta; i++) {
            if (i == 2) {
                continue;
            }
            if (i == 5) {
                break;
            }
            suma += i;
        }
        return suma;
    }

    // while con continue.
    public int mientrasConContinue(int limite) {
        int i;
        int suma;
        i = 0;
        suma = 0;
        while (i < limite) {
            i++;
            if (i == 2) {
                continue;
            }
            suma += i;
        }
        return suma;
    }

    // do while: el cuerpo corre al menos una vez.
    public int hacerMientras(int veces) {
        int vueltas;
        int suma;
        vueltas = 0;
        suma = 0;
        do {
            vueltas++;
            suma += vueltas;
        } while (vueltas < veces);
        return suma;
    }

    // El break sale solo del for interior.
    public int breakSoloElInterno(int n) {
        int i;
        int j;
        int cuenta;
        cuenta = 0;
        for (i = 0; i < n; i++) {
            for (j = 0; j < n; j++) {
                if (j == 1) {
                    break;
                }
                cuenta++;
            }
        }
        return cuenta;
    }

    // Tres niveles, y el break corta el mas externo.
    public int breakEnElExterno(int n) {
        int i;
        int j;
        int k;
        int vueltas;
        vueltas = 0;
        for (vueltas = 0; vueltas < n; vueltas++) {
            for (i = 0; i < n; i++) {
                for (j = 0; j < n; j++) {
                    for (k = 0; k < n; k++) {
                        if (vueltas == 1) {
                            break;
                        }
                    }
                }
            }
        }
        return vueltas;
    }

    // El continue del interior no salta el incremento del exterior.
    public int continueSoloElInterno(int n) {
        int i;
        int j;
        int cuenta;
        cuenta = 0;
        for (i = 0; i < n; i++) {
            for (j = 0; j < n; j++) {
                if (j == 0) {
                    continue;
                }
                cuenta++;
            }
        }
        return cuenta;
    }

    // switch con break en cada caso, con default y sin default.
    public int elegir(int valor) {
        int salida;
        salida = 0;
        switch (valor) {
            case 1:
                salida = 10;
                break;
            case 2:
                salida = 20;
                break;
            case 3:
                salida = 30;
                break;
            default:
                salida = 40;
        }
        return salida;
    }

    public int elegirSinDefault(int valor) {
        int salida;
        salida = -1;
        switch (valor) {
            case 1:
                salida = 1;
                break;
            case 2:
                salida = 2;
                break;
        }
        return salida;
    }

    public int clasificar(int nota) {
        if (nota > 69) {
            return 3;
        } else if (nota > 49) {
            return 2;
        } else if (nota > 29) {
            return 1;
        } else {
            return 0;
        }
    }

    // Ciclo dentro de un condicional, y condicional dentro del ciclo.
    public int anidados(int n) {
        int i;
        int suma;
        suma = 0;
        if (n > 0) {
            for (i = 0; i < n; i++) {
                if (i > 2) {
                    suma += 10;
                } else {
                    suma += 1;
                }
            }
        }
        return suma;
    }
}
