// Proyecto 1: el programa mas pequeno que compila.
// Variables de los tres tipos basicos, una operacion y salida.

VARIABILES >
    esto saludo: textum "Hola, mundo";
    esto anio: numerus 2026;
    esto total: numerus 0;
MAIOR >
    total = anio + 2026 - 2026;
    >> saludo;
    >> "El total es";
    >> total;
FINIS;
