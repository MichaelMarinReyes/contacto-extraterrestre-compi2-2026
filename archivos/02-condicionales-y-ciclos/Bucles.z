public class Bucles {
    int total;

    public int clasificar(int nota) {
        if (nota >= 70) {
            return 1;
        } else if (nota >= 50) {
            return 2;
        } else {
            return 0;
        }
    }

    public int recorrer(int limite) {
        int i;
        int suma;
        suma = 0;
        for (i = 0; i < limite; i++) {
            if (i == 3) {
                continue;
            }
            if (i == 8) {
                break;
            }
            suma += i;
        }
        i = 0;
        while (i < 3) {
            suma = suma * 2;
            i++;
        }
        do {
            suma = suma - 1;
            i--;
        } while (i > 0);
        return suma;
    }

    public void elegirCaso(int valor) {
        switch (valor) {
            case 1:
                println("uno");
                break;
            case 2:
                println("dos");
                break;
            default:
                println("otro");
        }
    }
}
