@startuml Diagrama de clases - Contacto 3xtrat3rr3str3D
' Arquitectura implementada al completar la Fase 1 del AST.
skinparam dpi 120
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 14
skinparam ranksep 42
skinparam class {
  BackgroundColor #FBFCFE
  BorderColor #46678A
  ArrowColor #46678A
  FontSize 11
}
legend right
  **Arquitectura implementada**
  ..|> implementación · --|> herencia
  *-- composición · o-- agregación · ..> dependencia
  ParseTree → constructores → AST propio → panel AST (Fase 1).
  Semántica y C3D todavía recorren ParseTree; migración pendiente.
endlegend

package "com.compi" {
  class Main {
    {static} +main(String[])
  }
}
package "com.compi.frontend" {
  class MainWindow {
    -workspace : WorkspaceActions
    -compilation : CompilationActions
    +compileActive()
    +openProject(File)
    +openInEditor(File)
  }
  class WorkspaceActions
  class CompilationActions {
    -compiler : Compiler
    -currentCMode : Mode
    -lastTargets : List<File>
    +compile()
  }
  class TopToolbar
  class FileTreePanel
  class EditorTabs
  class EditorPanel
  class SyntaxHighlighter
  class LineNumberComponent
  class TabHeader
  class ConsoleDock
  class StatusBar
  class WelcomePanel
  class NewFileDialog
  class ToolWindow
  class ToolWindowDock
  class ParserTreePanel
  class SymbolTablePanel
  class StackVisualizerPanel
  class ErrorTablePanel
  class TypeTablePanel
  class TableFilterBar
  class UiTheme
  class IdeIcons
}
package "com.compi.frontend.dot" {
  class TreeCanvas
  class DotModel
  class TreeLayout
}
package "com.compi.backend" {
  class Compiler {
    +compile(source, language, fileName) : boolean
    +setWorkingDirectory(File)
    +setCMode(Mode)
    +getAst() : ProgramNodeAST
    +getImportedAsts() : Map<String, ProgramNodeAST>
  }
  enum StackAction {
    SHIFT
    REDUCE
    NEUTRAL
  }
}
package "com.compi.backend.languages" {
  interface LanguageCompiler {
    +parse(source, errors) : ParseTree
    +buildAst(ParseTree, sourceFile) : ProgramNodeAST
    +importedAsts() : Map<String, ProgramNodeAST>
    +analyze(ParseTree, SymbolTable, errors)
    +generateIntermediate(ParseTree, SymbolTable, C3DGenerator)
    +loadImports(ParseTree, ...)
  }
  abstract AbstractLanguageCompiler
  class LanguageCompilerFactory
  class PigLatinCompiler
  class YCompiler
  class ZetarianoCompiler
}
package "com.compi.backend.languages.piglatin" {
  class PigLatinAstBuilder
  class PigLatinSemanticVisitor
  class PigLatinArrayAnalyzer
  class PigLatinConditionAnalyzer
  class PigLatinC3DVisitor
  class PigLatinConditionEmitter
  class PigLatinObjectEmitter
}
package "com.compi.backend.languages.y" {
  class YAstBuilder
  class YIndentLexer
  class YSemanticVisitor
  class YC3DVisitor
  class YDeclarationEmitter
  class YControlEmitter
  class YAccessEmitter
}
package "com.compi.backend.languages.zetariano" {
  class ZetarianoAstBuilder
  class ZetarianoSemanticVisitor
  class ZetarianoC3DVisitor
  class ZetarianoArrayEmitter
  class ZetarianoClassEmitter
  class ZetarianoConditionEmitter
}
package "com.compi.backend.ast" {
  interface ASTNode {
    +accept(ASTVisitor<?>) : void
    +line() : int
    +column() : int
  }
  interface "ASTVisitor<R>" as ASTVisitor {
    +visit(ProgramNodeAST) : R
    +visit(AssignmentNodeAST) : R
    +visit(LiteralNodeAST) : R
  }
  abstract "AbstractASTVisitor<R>" as AbstractASTVisitor
  abstract AbstractNodeAST {
    -line : int
    -column : int
    -sourceFile : String
    +sourceFile() : String
    +attachSource(String)
    +children() : List<ASTNode>
  }
  abstract AbstractStatementNodeAST
  abstract AbstractExpressionNodeAST
  abstract AbstractDefinitionNodeAST
}
package "com.compi.backend.ast.stmt" {
  class ProgramNodeAST {
    -imports : List<ImportNodeAST>
    -definitions : List<AbstractDefinitionNodeAST>
    -globals : List<AbstractStatementNodeAST>
    -statements : List<AbstractStatementNodeAST>
  }
  class BlockNodeAST
  class DeclarationNodeAST
  class AssignmentNodeAST
  class IfNodeAST
  class ElseIfNodeAST
  class WhileNodeAST
  class DoWhileNodeAST
  class ForNodeAST
  class SwitchNodeAST
  class SwitchCaseNodeAST
  class PrintNodeAST
  class ReadStatementNodeAST
  class ReturnNodeAST
  class BreakNodeAST
  class ContinueNodeAST
  class ExpressionStatementNodeAST
  class DefinitionStatementNodeAST
  class ImportNodeAST
}
package "com.compi.backend.ast.expr" {
  class LiteralNodeAST
  class IdentifierNodeAST
  class BinaryOperationNodeAST
  class UnaryOperationNodeAST
  class AssignmentExpressionNodeAST
  class MemberAccessNodeAST
  class IndexNodeAST
  class CallNodeAST {
    -callee : AbstractExpressionNodeAST
    -arguments : List<AbstractExpressionNodeAST>
  }
  class NewObjectNodeAST
  class NewArrayNodeAST
  class ArrayLiteralNodeAST
  class TernaryNodeAST
  class IncrementNodeAST
  class ReadExpressionNodeAST
  class InstanceInitNodeAST
  enum LiteralKind
  enum OperationKind
  enum ReadKind
}
package "com.compi.backend.ast.decl" {
  class FunctionDefinitionNodeAST
  class ParameterNodeAST
  class StructDefinitionNodeAST
  class FieldDefinitionNodeAST
  class ClassDefinitionNodeAST
  class MethodDefinitionNodeAST
  class ConstructorDefinitionNodeAST
  class AttributeDefinitionNodeAST
}
package "com.compi.backend.symbols" {
  class SymbolTable
  class Scope
  class Symbol
  class Type
  class TypeTable {
    +define(name, Type, Scope) : TypeEntry
    +resolve(name, Scope) : Type
    +getEntries() : List<TypeEntry>
    +clear()
  }
  class TypeEntry <<record>> {
    id : int
    name : String
    type : Type
    baseTypeId : Integer
    parentId : Integer
    dimension : int
    minimum : List<Integer>
    maximum : List<Integer>
    scopeId : int
    scopeName : String
  }
  class TypeCompatibility
  class CallValidator
  class ArrayLiteral
  enum DataType {
    INT
    DOUBLE
    CHAR
    BOOLEAN
    STRING
    STRUCT
    CLASS
    ARRAY
    VOID
    NULL
    UNKNOWN
  }
  enum SymbolCategory {
    VARIABLE
    PARAMETER
    FUNCTION
    METHOD
    CONSTRUCTOR
    STRUCT
    CLASS
    FIELD
  }
}
package "com.compi.backend.c3d" {
  class C3DGenerator
  class Quadruple
  enum QuadrupleOp
  class Triplet
  class IntermediateCodeManager
  class CCodeEmitter <<delegado>>
  class FlatEmitter {
    +build() : String
  }
  class FlatLayout
  class ArrayRuntime
  class HeapRuntime
  class FunctionRuntime
  class ValueRuntime
  enum Mode {
    TRIPLETS
    QUADRUPLES
  }
}
package "com.compi.backend.errors" {
  class CompilationError
  class Diagnostic
  enum ErrorType {
    LEXICAL
    SYNTACTIC
    SEMANTIC
  }
}
package "com.compi.backend.parser" {
  class ParseTrace
  class ParseStep
}
package "com.compi.backend.runtime" {
  class StackSimulator
  class StackState
  class Stack
}
package "com.compi.backend.utils" {
  class ParseTreeDotGenerator
  class ASTDotGenerator {
    +build(AbstractNodeAST, String) : String
  }
}

Main ..> MainWindow
MainWindow *-- WorkspaceActions
MainWindow *-- CompilationActions
CompilationActions *-- Compiler
WorkspaceActions ..> MainWindow
CompilationActions ..> MainWindow
MainWindow *-- TopToolbar
MainWindow *-- FileTreePanel
MainWindow *-- EditorTabs
MainWindow *-- ConsoleDock
MainWindow *-- StatusBar
MainWindow *-- ToolWindow
MainWindow *-- ParserTreePanel
MainWindow *-- SymbolTablePanel
MainWindow *-- StackVisualizerPanel
MainWindow *-- ErrorTablePanel
MainWindow *-- TypeTablePanel
WorkspaceActions ..> NewFileDialog
EditorTabs o-- EditorPanel
EditorTabs ..> TabHeader
EditorPanel *-- SyntaxHighlighter
EditorPanel *-- LineNumberComponent
ToolWindow *-- ToolWindowDock
ToolWindowDock o-- ParserTreePanel
ToolWindowDock o-- SymbolTablePanel
ToolWindowDock o-- StackVisualizerPanel
ToolWindowDock o-- ErrorTablePanel
ToolWindowDock o-- TypeTablePanel
ParserTreePanel *-- TreeCanvas
TreeCanvas o-- DotModel
TreeCanvas o-- TreeLayout
SymbolTablePanel *-- TableFilterBar
ErrorTablePanel *-- TableFilterBar
TypeTablePanel *-- TableFilterBar
TypeTablePanel ..> TypeEntry
CompilationActions ..> TypeEntry : instantánea por archivo
SymbolTablePanel ..> Symbol
ErrorTablePanel ..> CompilationError
StackVisualizerPanel ..> ParseStep
Compiler *-- SymbolTable
Compiler *-- C3DGenerator
Compiler *-- IntermediateCodeManager
Compiler ..> LanguageCompilerFactory
Compiler ..> LanguageCompiler
Compiler ..> ASTDotGenerator
Compiler o-- ProgramNodeAST : principal e importados
Compiler ..> ParseTrace
Compiler ..> CCodeEmitter
Compiler ..> StackSimulator
AbstractLanguageCompiler ..|> LanguageCompiler
PigLatinCompiler --|> AbstractLanguageCompiler
YCompiler --|> AbstractLanguageCompiler
ZetarianoCompiler --|> AbstractLanguageCompiler
LanguageCompilerFactory ..> LanguageCompiler
PigLatinCompiler ..> PigLatinSemanticVisitor
PigLatinCompiler ..> PigLatinC3DVisitor
PigLatinCompiler ..> PigLatinAstBuilder
YCompiler ..> YSemanticVisitor
YCompiler ..> YC3DVisitor
YCompiler ..> YAstBuilder
YCompiler ..> YIndentLexer
ZetarianoCompiler ..> ZetarianoSemanticVisitor
ZetarianoCompiler ..> ZetarianoC3DVisitor
ZetarianoCompiler ..> ZetarianoAstBuilder
PigLatinSemanticVisitor *-- PigLatinArrayAnalyzer
PigLatinSemanticVisitor *-- PigLatinConditionAnalyzer
PigLatinC3DVisitor *-- PigLatinConditionEmitter
PigLatinC3DVisitor *-- PigLatinObjectEmitter
YC3DVisitor *-- YDeclarationEmitter
YC3DVisitor *-- YControlEmitter
YC3DVisitor *-- YAccessEmitter
ZetarianoC3DVisitor *-- ZetarianoArrayEmitter
ZetarianoC3DVisitor *-- ZetarianoClassEmitter
ZetarianoC3DVisitor *-- ZetarianoConditionEmitter
ZetarianoClassEmitter o-- ZetarianoArrayEmitter
AbstractNodeAST ..|> ASTNode
AbstractASTVisitor ..|> ASTVisitor
AbstractStatementNodeAST --|> AbstractNodeAST
AbstractExpressionNodeAST --|> AbstractNodeAST
AbstractDefinitionNodeAST --|> AbstractNodeAST
ProgramNodeAST --|> AbstractNodeAST
BlockNodeAST --|> AbstractStatementNodeAST
DeclarationNodeAST --|> AbstractStatementNodeAST
AssignmentNodeAST --|> AbstractStatementNodeAST
IfNodeAST --|> AbstractStatementNodeAST
ElseIfNodeAST --|> AbstractNodeAST
WhileNodeAST --|> AbstractStatementNodeAST
DoWhileNodeAST --|> AbstractStatementNodeAST
ForNodeAST --|> AbstractStatementNodeAST
SwitchNodeAST --|> AbstractStatementNodeAST
SwitchCaseNodeAST --|> AbstractNodeAST
PrintNodeAST --|> AbstractStatementNodeAST
ReadStatementNodeAST --|> AbstractStatementNodeAST
ReturnNodeAST --|> AbstractStatementNodeAST
BreakNodeAST --|> AbstractStatementNodeAST
ContinueNodeAST --|> AbstractStatementNodeAST
ExpressionStatementNodeAST --|> AbstractStatementNodeAST
DefinitionStatementNodeAST --|> AbstractStatementNodeAST
DefinitionStatementNodeAST o-- AbstractDefinitionNodeAST
ImportNodeAST --|> AbstractNodeAST
LiteralNodeAST --|> AbstractExpressionNodeAST
IdentifierNodeAST --|> AbstractExpressionNodeAST
BinaryOperationNodeAST --|> AbstractExpressionNodeAST
UnaryOperationNodeAST --|> AbstractExpressionNodeAST
AssignmentExpressionNodeAST --|> AbstractExpressionNodeAST
MemberAccessNodeAST --|> AbstractExpressionNodeAST
IndexNodeAST --|> AbstractExpressionNodeAST
CallNodeAST --|> AbstractExpressionNodeAST
CallNodeAST o-- AbstractExpressionNodeAST : receptor y argumentos
NewObjectNodeAST --|> AbstractExpressionNodeAST
NewArrayNodeAST --|> AbstractExpressionNodeAST
ArrayLiteralNodeAST --|> AbstractExpressionNodeAST
TernaryNodeAST --|> AbstractExpressionNodeAST
IncrementNodeAST --|> AbstractExpressionNodeAST
ReadExpressionNodeAST --|> AbstractExpressionNodeAST
InstanceInitNodeAST --|> AbstractExpressionNodeAST
FunctionDefinitionNodeAST --|> AbstractDefinitionNodeAST
StructDefinitionNodeAST --|> AbstractDefinitionNodeAST
ClassDefinitionNodeAST --|> AbstractDefinitionNodeAST
MethodDefinitionNodeAST --|> AbstractDefinitionNodeAST
ConstructorDefinitionNodeAST --|> AbstractDefinitionNodeAST
AttributeDefinitionNodeAST --|> AbstractDefinitionNodeAST
ParameterNodeAST --|> AbstractNodeAST
FieldDefinitionNodeAST --|> AbstractNodeAST
AbstractNodeAST o-- ASTNode : children()
ProgramNodeAST o-- ImportNodeAST
ProgramNodeAST o-- AbstractDefinitionNodeAST
ProgramNodeAST o-- AbstractStatementNodeAST
BlockNodeAST o-- AbstractStatementNodeAST
LiteralNodeAST ..> LiteralKind
BinaryOperationNodeAST ..> OperationKind
UnaryOperationNodeAST ..> OperationKind
ReadExpressionNodeAST ..> ReadKind
IdentifierNodeAST ..> Symbol
ASTNode ..> ASTVisitor : accept()
ASTDotGenerator ..> AbstractNodeAST
package "com.compi.backend.ast.build" {
  abstract AbstractAstBuilder {
    +build(ParseTree, sourceFile) : ProgramNodeAST
    #buildRule(rule, ParserRuleContext) : ASTNode
  }
}
PigLatinAstBuilder --|> AbstractAstBuilder
YAstBuilder --|> AbstractAstBuilder
ZetarianoAstBuilder --|> AbstractAstBuilder
AbstractAstBuilder ..> ProgramNodeAST : construye
SymbolTable *-- Scope
SymbolTable *-- TypeTable
TypeTable o-- TypeEntry
TypeTable ..> Scope
TypeEntry o-- Type
TypeEntry ..> TypeEntry : tipo base / padre por ID
Scope o-- Symbol
Symbol o-- Type
Type ..> DataType
Symbol ..> SymbolCategory
C3DGenerator o-- Quadruple
Quadruple ..> QuadrupleOp
IntermediateCodeManager o-- Triplet
CCodeEmitter ..> FlatEmitter : delega
FlatEmitter *-- FlatLayout
FlatEmitter ..> Quadruple
FlatLayout ..> SymbolTable
ArrayRuntime ..> C3DGenerator
HeapRuntime ..> C3DGenerator
ValueRuntime ..> C3DGenerator
CompilationError ..> ErrorType
ParseTrace ..> ParseStep
ParseStep ..> StackAction
StackSimulator ..> Quadruple
StackSimulator ..> StackState
@enduml
