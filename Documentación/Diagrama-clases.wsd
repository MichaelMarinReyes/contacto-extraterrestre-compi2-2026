package "com.compi.backend.ast" {
  interface ASTNode {
    + accept(ASTVisitor<?>) : void
    + line() : int
    + column() : int
  }
  interface "ASTVisitor<R>" as ASTVisitor {
    + visit(ProgramNodeAST) : R
    + visit(AssignmentNodeAST) : R
    + visit(LiteralNodeAST) : R
    + visit(CallNodeAST) : R
    + visit(ClassDefinitionNodeAST) : R
  }
  abstract "AbstractASTVisitor<R>" as AbstractASTVisitor {
    + AbstractASTVisitor()
    + visit(ProgramNodeAST) : R
    + visit(AssignmentNodeAST) : R
    + visit(LiteralNodeAST) : R
    + visit(CallNodeAST) : R
    + visit(ClassDefinitionNodeAST) : R
  }
  abstract AbstractNodeAST {
    - line : int
    - column : int
    - sourceFile : String
    # AbstractNodeAST(int, int)
    + sourceFile() : String
    + attachSource(String) : void
    + line() : int
    + column() : int
    + {abstract} children() : List<ASTNode>
    + toString() : String
  }
  abstract AbstractStatementNodeAST {
