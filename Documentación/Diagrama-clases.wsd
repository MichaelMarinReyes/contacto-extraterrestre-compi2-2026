    + {static} hasAllowedExtension(String) : boolean
  }
  class PigLatinCompiler {
    - astImports : Map<String, ProgramNodeAST>
    - semanticImports : Map<String, SemanticModel>
    - {static} PENDING : ThreadLocal<List<PendingGeneration>>
    - {static} IMPORT_DEPTH : ThreadLocal<Integer>
    + PigLatinCompiler()
    + buildAst(ParseTree, String) : ProgramNodeAST
    + displayName() : String
    + extensions() : List<String>
    + id() : String
    + importedAsts() : Map<String, ProgramNodeAST>
    + importedSemanticModels() : Map<String, SemanticModel>
    + loadImports(ProgramNodeAST, SymbolTable, C3DGenerator, List<CompilationError>, List<String>) : List<String>
    + parse(String, List<CompilationError>) : ParseTree
    - compileImport(ImportNodeAST, File, String, SymbolTable, C3DGenerator, List<CompilationError>, List<String>, List<String>) : void
    - flushPending(SymbolTable, C3DGenerator) : void
  }
  class PendingGeneration <<record>> {
    - compiler : LanguageCompiler
    - ast : ProgramNodeAST
    + compiler() : LanguageCompiler
    + ast() : ProgramNodeAST
  }
  class YCompiler {
    + YCompiler()
    + buildAst(ParseTree, String) : ProgramNodeAST
